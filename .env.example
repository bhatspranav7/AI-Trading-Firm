# Copy to .env and edit. Everything has a sane default.

# Market
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
MARKET_MODE=live            # live = Binance public websocket, sim = offline random walk
CANDLE_INTERVAL=1m
HISTORY_CANDLES=300

# Paper account
CAPITAL_INR=2500000
USDINR=0                    # 0 = fetch at startup, else fixed rate
FEE_RATE=0.0004             # taker fee per side
MAX_COMMITTED=0.30          # max share of capital locked as margin across all desks
MAX_PER_POSITION=0.15       # max share of capital as margin in one position
MAX_LEVERAGE=5

# Agents (Ollama, open source, runs locally)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2       # try llama3.1:8b or qwen2.5:7b for sharper reasoning
OLLAMA_TIMEOUT=180

# Who is CEO
CEO_MODE=human              # human = meetings end in a recommendation and wait for you; ai = the agent decides
DECISION_TIMEOUT_SEC=300    # how long a decision waits for you
DECISION_TIMEOUT_ACTION=stand_down   # or follow_advisor
CEO_PASSCODE=               # set one to lock the control endpoints when deployed

# Boardroom cadence
MEETING_INTERVAL_SEC=180    # scheduled review per desk
SCAN_INTERVAL_SEC=20        # how often desks scan for a setup
SETUP_THRESHOLD=0.35        # |indicator bias| that triggers an unscheduled meeting

# Server
HOST=127.0.0.1
PORT=8000
DB_PATH=data/firm.db
